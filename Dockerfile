FROM debian:stable

RUN apt-get update && \
        apt-get install -y  \
            asn1c make golang gcc libc6-dev python3 python3-venv python3-pip

WORKDIR /build 

ADD . /build 

# perform a compile and run
RUN make build_all run_all

